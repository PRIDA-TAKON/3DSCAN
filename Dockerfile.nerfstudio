# === Image B: The Trainer (Nerfstudio Official) ===
FROM nerfstudio/nerfstudio:latest

USER root
# ลง Git และ Library เชื่อมต่อเพิ่มแค่นิดเดียว
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

USER user
WORKDIR /app

# ติดตั้งเฉพาะตัวจัดการฐานข้อมูลใน User Space
RUN pip install --no-cache-dir --user supabase runpod requests

# ใช้ loader.py ตัวเดิมดึงโค้ด Git
COPY --chown=user:user loader.py .

# ตั้งค่า PATH ให้เรียกใช้เครื่องมือใน .local ได้
ENV PATH="/home/user/.local/bin:${PATH}"
ENV WORKER_MODE="TRAIN"

ENTRYPOINT ["python3", "/app/loader.py"]
