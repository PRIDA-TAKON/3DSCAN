FROM nerfstudio/nerfstudio:latest

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb ffmpeg libsm6 libxext6 libgl1-mesa-glx git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

USER user
WORKDIR /app

# เพิ่ม websockets>=13.0 และ boto3 สำหรับ S3 storage
RUN pip install --no-cache-dir --user supabase runpod requests "websockets>=13.0" boto3

COPY --chown=user:user loader.py .

ENV PATH="/home/user/.local/bin:${PATH}"
ENV WORKER_MODE="TRAIN"

ENTRYPOINT ["python3", "/app/loader.py"]
