FROM ghcr.io/nerfstudio-project/nerfstudio:latest

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb ffmpeg libsm6 libxext6 libgl1-mesa-glx git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# เพิ่ม websockets>=13.0 และ boto3 สำหรับ S3 storage
RUN python3 -m pip install --no-cache-dir supabase runpod requests "websockets>=13.0" boto3

COPY loader.py .

ENV WORKER_MODE="TRAIN"

ENTRYPOINT ["python3", "/app/loader.py"]
