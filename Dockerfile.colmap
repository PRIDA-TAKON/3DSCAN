# === Image A: The Processor (COLMAP + FFmpeg) ===
FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    colmap ffmpeg libsm6 libxext6 libgl1-mesa-glx git python3 python3-pip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# ติดตั้ง Library พื้นฐานสำหรับเชื่อมต่อ
RUN pip3 install --no-cache-dir supabase runpod requests opencv-python-headless

# ใช้ loader.py ตัวเดิมเพื่อดึงโค้ดจาก Git
COPY loader.py .

# กำหนดสคริปต์ที่จะรันเป็นโหมด Processor
ENV WORKER_MODE="PROCESS"
ENTRYPOINT ["python3", "/app/loader.py"]
